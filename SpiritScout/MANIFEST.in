# 运维脚本：文档里直接让人跑 `python scripts/bootstrap.py` / `scripts/probe_deps.py`，
# 缺了这些路径就成了空指路（之前 sdist 里确实没有）。
recursive-include scripts *.py
# 编译缓存不是源码：本机构建时 scripts/__pycache__ 会跟着进去，白占体积
global-exclude *.pyc *.pyo
# 桌面版（Windows 自带窗口的客户端）：源码与编译脚本进 sdist，够别人自己编；
# 下下来的 WebView2 SDK 缓存（约 8 MB）与编好的 exe 不入包——exe 作为 release 附件单独发。
include launcher/SpiritScoutDesktop.cs
include launcher/build-desktop.ps1 launcher/build-portable.ps1
include launcher/SpiritScoutLauncher.cs
include launcher/build-launcher.ps1
prune launcher/.cache
prune launcher/tools
# 源码分发包的补充清单。
# setuptools 默认只收测试目录里的 *.py，前端那套 node 测试（tests/test_*.js）
# 一直没进 sdist——从源码包构建的人因此跑不了 AGENTS 要求的 `node tests/test_*.js`。
recursive-include tests *.js

# 随包发布的做题经验：EXPERIENCE.md 是给人看的摘要，knowledge/data/ 下的
# experience.json / experience.md 是 wheel 里那份机读与摘要素材（由
# `python -m spiritscout.knowledge.digest` 在打包时生成）。
include EXPERIENCE.md
include src/spiritscout/knowledge/data/experience.json
include src/spiritscout/knowledge/data/experience.md

# 技能库：skills/ 是技能包的原始素材（多轮实战沉淀的 SKILL.md 与参考文档），
# 装完想看/想改的人得拿得到，所以整目录进 sdist。
graft skills

# 但技能包里的插图与演示视频（合计约 126 MB 的 png/gif/mp4）不进 sdist：
# 它只压缩到 150 MB，纯属白占带宽；文字素材齐了就够用，全量素材在 zip 里。
# 这些扩展名在 skills/ 以外没有分布（docs 只有 svg），所以整包排除是安全的。
global-exclude *.png *.jpg *.jpeg *.gif *.mp4 *.webm

# 配置文件只收模板与技能清单——真实 models.yaml / agent_models.yaml / system.yaml
# 带供应商端点与密钥，绝不能进包（它们本来也在 .gitignore 里，这里显式点名是为了
# 不依赖 .gitignore：MANIFEST 看的是磁盘目录，不是 git 跟踪列表）。
include configs/skills.yaml
include configs/models.example.yaml
include configs/models.mock.yaml
include configs/system.example.yaml
