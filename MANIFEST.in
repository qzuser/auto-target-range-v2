# 运维脚本：文档里直接让人跑 `python scripts/bootstrap.py` / `scripts/probe_deps.py`。
# 平台启动器也需要随 sdist 发布，方便从源码包复现 Windows 与 Linux 入口。
graft scripts
prune scripts/__pycache__
include Start-SpiritScout.cmd
include Dockerfile
include docker-compose.yml
include docker-compose.dev.yml
include deploy.py
include .env.example
# 编译缓存不是源码：本机构建时 scripts/__pycache__ 会跟着进去，白占体积
global-exclude *.pyc *.pyo
# 原生桌面端：Kotlin Compose 源码、图标与 Windows 打包脚本进 sdist。
# 编好的 app-image / zip 作为 release 附件单独发，不塞进 Python 包。
graft desktop
prune desktop/build
prune desktop/.gradle
prune desktop/.kotlin
prune desktop/SpiritScoutCompose
include desktop/THIRD_PARTY_NOTICES.md
include desktop/THIRD_PARTY/SaltUI-LICENSE.txt
include desktop/src/main/resources/favicon.png
graft packaging/windows
prune packaging/windows/.cache

# Web 会话阅读器的 TypeScript 源码、构建配置和 Node 测试必须完整随 sdist 发布。
graft frontend
prune frontend/node_modules

# 测试夹具与 JavaScript 回归测试也要能从源码包运行。
graft tests
prune tests/__pycache__

# 原生流量代理与经验同步工具属于可复现源码的一部分。
graft traffic-proxy
graft tools/experience-export
prune tools/experience-export/__pycache__

# 随包发布的做题经验：docs/workspace/EXPERIENCE.md 是给人看的摘要，knowledge/data/ 下的
# experience.json / experience.md 是 wheel 里那份机读与摘要素材（由
# `python -m spiritscout.knowledge.digest` 在打包时生成）。
graft docs
include src/spiritscout/knowledge/data/experience.json
include src/spiritscout/knowledge/data/experience.md

# 自定义技能真源是 configs/skills.yaml；归档技能在
# src/spiritscout/knowledge/data/archive_skills.json。仓库不再引用不存在的
# 顶层 skills/ 目录。

# 配置文件只收模板与技能清单——真实 models.yaml / agent_models.yaml / system.yaml
# 带供应商端点与密钥，绝不能进包（它们本来也在 .gitignore 里，这里显式点名是为了
# 不依赖 .gitignore：MANIFEST 看的是磁盘目录，不是 git 跟踪列表）。
include configs/skills.yaml
include configs/models.example.yaml
include configs/models.mock.yaml
include configs/system.example.yaml
