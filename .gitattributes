# 行尾规则：钩子脚本和它依赖的 python 必须保持 LF。
# core.autocrlf=true 的机器上如果被转成 CRLF，`#!/bin/sh` 会变成 `#!/bin/sh\r`，
# 钩子直接跑不起来（bad interpreter）。
tools/experience-export/git-hooks/* text eol=lf
tools/experience-export/*.py text eol=lf

# Docker 启动脚本在 Windows 检出时也必须使用 LF。
deploy/browser/*.sh text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
